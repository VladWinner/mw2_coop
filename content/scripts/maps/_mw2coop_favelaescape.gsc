// mw2coop: Escape from Favela (The Hornet's Nest) for two players. Called from mw2coop/patches/maps/
// favela_escape_code.gsc.patch and favela_escape.gsc.patch (generated by tools/gen_seek_patches.py and
// tools/gen_favela_escape_patches.py); outside a co-op campaign session every entry point does what
// the original code did.
//
// The chopper's rope ladder at the end (solorun_chopperjump): the level waited for level.player to
// leap for the ladder, then played the catch-the-rope scene with his rig and flew away; player 2
// stayed on the roof and the level ended without him. Now whichever player leaps for the ladder
// first starts the scene, and the other catches the same rope with a rig of his own (partner_jumps),
// brought to the ledge first when he is far; both screens fade out at the end.
#include common_scripts\utility;
#include maps\_utility;
#include maps\_anim;

coop()
{
	return maps\_mw2coop::is_campaign_coop() && isdefined( level.player2 );
}

// solorun_chopperjump(): the player who leaps for the ladder first. The level's own watcher reads
// player 1's jump key; here each player's jump is seen as leaving the ground upwards (IsOnGround()
// reads 0 for player 2, so maps\_mw2coop::is_standing() looks at the floor).
catch_leap( volume, ladder, look_spots )
{
	foreach ( player in level.players )
	{
		player.mw2coop_stood = true;
		player.mw2coop_jumping = false;
	}
	for ( ;; )
	{
		foreach ( player in level.players )
		{
			if ( !isalive( player ) )
				continue;
			standing = maps\_mw2coop::is_standing( player );
			vel = player GetVelocity();
			if ( standing )
				player.mw2coop_jumping = false;
			else if ( player.mw2coop_stood && vel[ 2 ] > 100 )
				player.mw2coop_jumping = true;
			player.mw2coop_stood = standing;
			if ( player.mw2coop_jumping && maps\favela_escape_code::player_leaps_to_chopper( volume, ladder, look_spots, true, player ) )
				return player;
		}
		wait 0.05;
	}
}

// solorun_chopperjump(), where the jump scene starts for who: the other player catches the rope too.
partner_jumps( who, chopper, scene, tag )
{
	if ( !coop() )
		return;
	other = maps\_mw2coop::other_player( who );
	if ( !isdefined( other ) || !isalive( other ) )
		return;
	other notify( "stop_sliding" );
	other DisableWeapons();
	other AllowJump( false );
	other AllowCrouch( false );
	other AllowProne( false );
	if ( Distance( other.origin, who.origin ) > 120 )
		other SetOrigin( who.origin );
	rig = spawn_anim_model( "player", chopper.origin );
	rig Hide();
	rig LinkTo( chopper, tag );
	chopper thread anim_single_solo( rig, scene, tag );
	maps\_mw2coop::state( "favela_escape: the second player catches the rope too" );
	wait 0.3;
	other PlayerLinkToBlend( rig, "tag_player", 0.6, 0.2, 0.4 );
	wait 0.6;
	rig Show();
}

// solorun(), where the screen of player 1 fades to black.
partner_black( fade_time )
{
	if ( !coop() )
		return;
	hud = maps\_hud_util::create_client_overlay( "black", 0, level.player2 );
	hud FadeOverTime( fade_time );
	hud.alpha = 1;
}
