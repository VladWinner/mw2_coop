// mw2coop: Of Their Own Accord (dcburning) for two players. Called from
// mw2coop/patches/maps/dcburning.gsc.patch (generated by tools/gen_dcburning_patches.py); outside
// a co-op campaign session every entry point does nothing.
//
// The Black Hawk ride over Washington: player 1 mans the door minigun as before; player 2 rides in
// the cabin as a passenger and shoots out with his own weapon (owner, 2026-10-22: as COD-MOD did;
// before, he stayed on the roof). Both are invulnerable on board as player 1 alone was, through
// the crash; the crash site then takes both over (maps\_mw2coop_crashsite).
#include common_scripts\utility;
#include maps\_utility;

coop()
{
	return maps\_mw2coop::is_campaign_coop() && isdefined( level.player2 );
}

// Player 1 gets on the minigun (or a start point puts him there). Player 2 rides at the
// helicopter's passenger tag, tag_playerride, linked as COD-MOD does (PlayerLinkTo: his view keeps
// the world's up; a seat linked with the helicopter's angles turned his view upside down as it
// banked, QA 2026-10-22).
partner_boards()
{
	if ( !coop() || isdefined( level.mw2coop_heli_rider ) || !isdefined( level.blackhawk ) )
		return;
	level.mw2coop_heli_rider = level.player2;
	p2 = level.player2;
	p2 EnableInvulnerability();
	p2 AllowProne( false );
	p2 AllowSprint( false );
	p2 AllowJump( false );
	p2 PlayerLinkTo( level.blackhawk, "tag_playerride", 1, 180, 180, 40, 40 );
	p2 EnableWeapons();
	maps\_mw2coop::state( "dcburning: player 2 rides in the Black Hawk's cabin" );
}

// The missile hits: like player 1 he puts his weapon away and holds on, his view narrowed.
partner_holds_on()
{
	if ( !coop() || !isdefined( level.mw2coop_heli_rider ) )
		return;
	level.player2 DisableWeapons();
	level.player2 PlayerLinkTo( level.blackhawk, "tag_playerride", 1, 20, 20, 10, 10 );
}

// The screen is black and the wreck goes away: off the helicopter, for the crash site.
partner_lets_go()
{
	if ( !isdefined( level.mw2coop_heli_rider ) )
		return;
	if ( level.player2 IsLinked() )
		level.player2 Unlink();
	level.player2 AllowProne( true );
	level.player2 AllowSprint( true );
	level.player2 AllowJump( true );
	level.mw2coop_heli_rider = undefined;
}
