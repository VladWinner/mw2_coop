// mw2coop: the Black Hawk crash site for two players: the end of "Of Their Own Accord"
// (dcburning) and the start of "Second Sun" (dcemp) share maps\dc_crashsite. Called from
// mw2coop/patches/maps/dc_crashsite.gsc.patch (generated by tools/gen_dcemp_patches.py); outside
// a co-op campaign session every entry point does what the original code did. Loaded in both
// zones: names only maps\dc_crashsite, never maps\dcemp or maps\dcburning.
//
// Player 2 wakes up in the wreck beside player 1 with his own rig (same animation), moves inside
// the cabin on his own, and gets his own rifle and Foley's magazine too.
#include common_scripts\utility;
#include maps\_utility;
#include maps\_anim;

coop()
{
	return maps\_mw2coop::is_campaign_coop() && isdefined( level.player2 );
}

// AAA_sequence_player_crash_site(), after player 1's rig is put in its first frame.
partner_rig_setup( crash_node, p1_rig )
{
	if ( !coop() )
		return;
	p2 = level.player2;
	grid_tl = GetEnt( "movement_grid_top_left", "targetname" );
	grid_br = GetEnt( "movement_grid_bot_right", "targetname" );
	// beside player 1 on the side with the clearer view out of the wreck (the hull is close on
	// one side), inside the cabin's movement grid
	right = AnglesToRight( ( 0, p1_rig.angles[ 1 ], 0 ) );
	forward = AnglesToForward( ( 0, p1_rig.angles[ 1 ], 0 ) );
	eye = p1_rig GetTagOrigin( "tag_player" );
	offset = right * 36;
	best = -1;
	for ( side = 1; side >= -1; side -= 2 )
	{
		try = right * ( 36 * side );
		if ( !in_grid( p1_rig.origin + try, grid_tl, grid_br ) )
			continue;
		view = 0;
		for ( a = -30; a <= 30; a += 15 )
		{
			dir = AnglesToForward( ( 0, p1_rig.angles[ 1 ] + a, 0 ) );
			trace = BulletTrace( eye + try, eye + try + dir * 400, false, undefined );
			view += trace[ "fraction" ];
		}
		if ( view > best )
		{
			best = view;
			offset = try;
		}
	}
	node = Spawn( "script_origin", crash_node.origin + offset );
	node.angles = crash_node.angles;
	rig = spawn_anim_model( "player_rig" );
	node anim_first_frame_solo( rig, "dcburning_BHrescue" );
	level.mw2coop_crash_rig = rig;
	level.mw2coop_crash_node = node;
	p2 EnableInvulnerability();
	p2 FreezeControls( true );
	p2 AllowStand( true );
	p2 AllowProne( false );
	p2 AllowSprint( false );
	p2 AllowJump( false );
	p2 AllowCrouch( false );
	p2 PlayerLinkToDelta( rig, "tag_player", 1, 0, 0, 0, 0, true );
	p2 thread maps\dc_crashsite::player_crash_movement( grid_tl, grid_br, rig );
	maps\_mw2coop::state( "crash site: player 2 wakes up " + int( Length( offset ) ) + " units beside player 1" );
}

in_grid( org, tl, br )
{
	return org[ 0 ] <= tl.origin[ 0 ] && org[ 0 ] >= br.origin[ 0 ] && org[ 1 ] <= br.origin[ 1 ] && org[ 1 ] >= tl.origin[ 1 ];
}

// When player 1's rig starts its wake-up animation.
partner_rig_play()
{
	if ( !coop() || !isdefined( level.mw2coop_crash_rig ) )
		return;
	level.mw2coop_crash_node thread anim_single_solo( level.mw2coop_crash_rig, "dcburning_BHrescue" );
}

// Every player (player 1 outside co-op).
crash_players()
{
	if ( !coop() )
	{
		a = [];
		a[ 0 ] = level.player;
		return a;
	}
	return level.players;
}

// AA_crash_site_init(): every player gets his rifle.
gun_behavior()
{
	foreach ( player in crash_players() )
		player thread maps\dc_crashsite::player_crash_gun_behavior();
}
