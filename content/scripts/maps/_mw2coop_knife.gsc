// mw2coop: the knife fight with Shepherd (end of Endgame) for two players. Called from
// mw2coop/patches/maps/af_chase_knife_fight.gsc.patch and af_chase_knife_fight_code.gsc.patch
// (generated by tools/gen_knife_patches.py). The two scripts are the same in the af_chase and
// ending zones, so this file names only them and the common scripts. Outside a co-op campaign
// session every entry point does what the original code did.
//
// Owner's design (2026-10-20): both players are wounded. Both wake up after the crash, side by
// side. The scene's player (level.mw2coop_lead, every level.player of the scene) is whoever
// strikes Shepherd first: he is stabbed, hears the monologue, crawls to the revolver, pulls the
// knife out of his chest and throws it. The other player is down too: he crawls on his own and
// sees the fight; he gets up when Nikolai's helicopter comes.
#include common_scripts\utility;
#include maps\_utility;
#include maps\_anim;

coop()
{
	return maps\_mw2coop::is_campaign_coop() && isdefined( level.player2 );
}

player_name( player )
{
	if ( player == level.player )
		return "player 1";
	return "player 2";
}

// --------------------------------------------------------------------------------------------
// Wake-up: player 2 wakes up beside player 1 with his own rig and the same animation.

// wakeup_after_crash(), once player 1 is on his rig in its first frame.
partner_wakeup( anim_node, scene )
{
	if ( !coop() )
		return;
	p2 = level.player2;
	right = AnglesToRight( ( 0, anim_node.angles[ 1 ], 0 ) );
	offset = wakeup_offset( anim_node, right );
	node = Spawn( "script_origin", anim_node.origin + offset );
	node.angles = anim_node.angles;
	rig = spawn_anim_model( "player_rig" );
	node anim_first_frame_solo( rig, scene );
	p2 DisableWeapons();
	p2 FreezeControls( true );
	p2 PlayerLinkToDelta( rig, "tag_player", 1, 0, 0, 0, 0, true );
	maps\_mw2coop::state( "knife fight: player 2 wakes up " + int( Length( offset ) ) + " units beside player 1" );
	p2 thread partner_wakeup_anim( node, rig, scene );
}

wakeup_offset( anim_node, right )
{
	for ( side = 1; side >= -1; side -= 2 )
	{
		foreach ( dist in strtok( "64 80 96", " " ) )
		{
			d = int( dist );
			at = anim_node.origin + right * ( d * side );
			floor = PlayerPhysicsTrace( at + ( 0, 0, 40 ), at - ( 0, 0, 80 ) );
			if ( abs( floor[ 2 ] - anim_node.origin[ 2 ] ) < 24 && BulletTracePassed( anim_node.origin + ( 0, 0, 30 ), at + ( 0, 0, 30 ), false, undefined ) )
				return ( floor[ 0 ], floor[ 1 ], anim_node.origin[ 2 ] ) - anim_node.origin;
		}
	}
	return right * 64;
}

// self: player 2.
partner_wakeup_anim( node, rig, scene )
{
	node anim_single_solo( rig, scene );
	self Unlink();
	rig Delete();
	node Delete();
	self FreezeControls( false );
	self wounded_walk();
}

// The wounded walk before the fight (player 1 has the level's own aftermath walk).
wounded_walk()
{
	self AllowSprint( false );
	self AllowJump( false );
	self AllowProne( false );
	self SetMoveSpeedScale( 0.45 );
	self ShellShock( "af_chase_ending_wakeup", 8 );
}

// --------------------------------------------------------------------------------------------
// Who is the scene's player

// wait_for_player_to_melee_shepherd(), each check: the player nearer to Shepherd is the one who
// can strike him (player 1 outside co-op).
choose_lead()
{
	if ( !coop() )
		return;
	best = level.player;
	if ( IsAlive( level.player2 ) && Distance( level.player2.origin, level.shepherd.origin ) < Distance( level.player.origin, level.shepherd.origin ) )
		best = level.player2;
	level.mw2coop_lead = best;
}

// track_melee(): a melee by any player (the nearer one is checked against Shepherd).
any_meleeing()
{
	if ( !coop() )
		return level.player IsMeleeing();
	foreach ( player in level.players )
		if ( player IsMeleeing() || isdefined( player.mw2coop_qa_melee ) )
			return true;
	return false;
}

// fight_turnbuckle(), right after the strike: the other player goes down and watches.
lead_decided()
{
	if ( !coop() )
		return;
	lead = level.mw2coop_lead;
	maps\_mw2coop::state( "knife fight: " + player_name( lead ) + " strikes Shepherd" );
	witness = maps\_mw2coop::other_player( lead );
	if ( isdefined( witness ) && IsAlive( witness ) )
		witness thread witness_think();
}

// self: the other player (owner's decision 2026-10-20: he drifts in and out of consciousness).
// The scene has first-person arm animations only for the lead and players have no body model in
// the campaign, so whoever looked at the lead would see floating arms. The witness passes out
// when the lead strikes (his own black screen, breathing and heartbeat), comes to for the wide
// moments - Price fighting Shepherd, the knife in Shepherd's eye - and passes out again before
// the end. While awake his view is held at ground level beside the fight, turned so that the
// lead is always outside what he can see; if the lead or a wall gets in the way he blacks out
// for a moment and wakes up in a better spot. No weapons, no damage.
witness_think()
{
	level.mw2coop_knife_witness = self;
	self EnableInvulnerability();
	self DisableWeapons();
	// no stance limits: the engine drops the session when a linked player may neither stand nor
	// crouch ("All stances ... disallowed for linked player"); the view is the camera's anyway
	self SetStance( "prone" );
	self ShellShock( "af_chase_ending_wakeup", 6 );
	self.mw2coop_blackout = maps\_hud_util::create_client_overlay( "black", 0, self );
	self.mw2coop_blackout.sort = 1000;
	self.mw2coop_blackout FadeOverTime( 1.5 );
	self.mw2coop_blackout.alpha = 1;
	// owner (2026-10-20): the black screen says why ("You are stunned, wait for the other player")
	self stunned_texts_create();
	self stunned_texts_fade( 1, 1.5 );
	self.mw2coop_awake = false;
	wait 1.5;
	// out cold where he lies; a place to watch from is found when he comes to
	cam = Spawn( "script_model", self.origin + ( 0, 0, 14 ) );
	cam SetModel( "tag_origin" );
	cam.angles = ( 0, self.angles[ 1 ], 0 );
	level.mw2coop_knife_cam = cam;
	self PlayerLinkToDelta( cam, "tag_origin", 1, 25, 25, 15, 10, true );
	// the view sits above the tag by the player's eye height (standing height even when he was
	// set prone): measured once, the camera goes that much lower than the eye point it serves
	wait 0.1;
	eye = self GetEye();
	self.mw2coop_eye_dz = eye[ 2 ] - cam.origin[ 2 ];
	maps\_mw2coop::state( "knife fight: " + player_name( self ) + " is down and passes out" );
	self thread witness_breathing();
	self thread witness_follow( cam );
}

// The other player is the lead's partner; whoever is not the lead.
witness()
{
	if ( !coop() || !isdefined( level.mw2coop_knife_witness ) )
		return undefined;
	return level.mw2coop_knife_witness;
}

// knife_kill(): the knife is out of the lead's chest; the other player comes to and sees the
// throw and Shepherd's death.
witness_wakes()
{
	w = witness();
	if ( !isdefined( w ) )
		return;
	w.mw2coop_want_awake = true;
	maps\_mw2coop::state( "knife fight: " + player_name( w ) + " comes to" );
}

// Passes out again (not used at the moment: he stays awake through Price waking up, where the
// lead has a full body, and passes out at the walk to the helicopter, witness_gets_up()).
witness_passes_out()
{
	w = witness();
	if ( !isdefined( w ) )
		return;
	w.mw2coop_want_awake = false;
	maps\_mw2coop::state( "knife fight: " + player_name( w ) + " passes out" );
}

// self: witness. Hurt breathing and heartbeat while he is out.
witness_breathing()
{
	level endon( "mw2coop_knife_witness_up" );
	for ( ;; )
	{
		if ( !self.mw2coop_awake )
			self PlayLocalSound( "breathing_heartbeat" );
		wait RandomFloatRange( 1.4, 2.2 );
	}
}

// Where the fight happens: between Shepherd and Price when they are there, else the lead.
scene_focus()
{
	pts = [];
	if ( isdefined( level.shepherd ) )
		pts[ pts.size ] = level.shepherd GetTagOrigin( "tag_eye" );
	// Price only when he is in the fight with Shepherd (else he lies somewhere off)
	if ( isdefined( level.price ) && IsAlive( level.price ) && ( !pts.size || Distance( level.price.origin, pts[ 0 ] ) < 300 ) )
		pts[ pts.size ] = level.price GetTagOrigin( "tag_eye" );
	if ( !pts.size )
		return level.mw2coop_lead GetEye();
	sum = ( 0, 0, 0 );
	foreach ( pt in pts )
		sum += pt;
	return sum * ( 1.0 / pts.size );
}

// Is the lead (his first-person arms) outside what the witness can see from eye, looking at
// focus? max_dot 0.15 = more than ~81 degrees apart (his view arcs, 25 degrees each side, plus
// half the field of view); 0.5 = 60 degrees.
lead_out_of_view( eye, focus, max_dot )
{
	if ( !isdefined( max_dot ) )
		max_dot = 0.5;
	lead = level.mw2coop_lead GetEye();
	to_focus = VectorNormalize( ( focus[ 0 ] - eye[ 0 ], focus[ 1 ] - eye[ 1 ], 0 ) );
	to_lead = VectorNormalize( ( lead[ 0 ] - eye[ 0 ], lead[ 1 ] - eye[ 1 ], 0 ) );
	return VectorDot( to_focus, to_lead ) < max_dot;
}

// A spot on the ground 120-240 units from the focus with floor near the focus' height, a clear
// line to it, and the lead out of view (the widest angle first). The eye is low, as a man lying
// on the ground.
watch_spot( focus )
{
	foreach ( max_dot in strtok( "0.15 0.34 0.5", " " ) )
	{
		spot = watch_spot_within( focus, float_of( max_dot ) );
		if ( isdefined( spot ) )
			return spot;
	}
	return undefined;
}

float_of( text )
{
	if ( text == "0.15" )
		return 0.15;
	if ( text == "0.34" )
		return 0.34;
	return 0.5;
}

watch_spot_within( focus, max_dot )
{
	lead = level.mw2coop_lead;
	to_lead = VectorToAngles( ( lead.origin[ 0 ], lead.origin[ 1 ], focus[ 2 ] ) - focus );
	ground = PlayerPhysicsTrace( focus, focus - ( 0, 0, 200 ) );
	foreach ( yaw in strtok( "90 -90 70 -70 110 -110 130 -130 50 -50", " " ) )
	{
		foreach ( dist in strtok( "160 120 200 240", " " ) )
		{
			dir = AnglesToForward( ( 0, to_lead[ 1 ] + int( yaw ), 0 ) );
			at = focus + dir * int( dist );
			floor = PlayerPhysicsTrace( ( at[ 0 ], at[ 1 ], ground[ 2 ] + 60 ), ( at[ 0 ], at[ 1 ], ground[ 2 ] - 80 ) );
			if ( abs( floor[ 2 ] - ground[ 2 ] ) > 48 )
				continue;
			eye = floor + ( 0, 0, 22 );
			if ( !BulletTracePassed( eye, focus, false, undefined ) )
				continue;
			if ( !lead_out_of_view( eye, focus, max_dot ) )
				continue;
			return eye;
		}
	}
	return undefined;
}

// self: the witness. While he should be awake and a good spot exists, his screen clears; when
// the lead or a wall comes into the way, or the fight moves off, he blacks out for a moment and
// comes to in a new spot.
witness_follow( cam )
{
	level endon( "mw2coop_knife_witness_up" );
	self.mw2coop_want_awake = false;
	last_focus = scene_focus();
	for ( ;; )
	{
		wait 0.05;
		if ( !isdefined( cam ) )
			return;
		focus = scene_focus();
		// the scene moves Shepherd and Price between its parts under the lead's fades or out of
		// his view; from the witness' spot that would show, so he is out then
		jumped = Distance( focus, last_focus ) > 80;
		last_focus = focus;
		eye = self GetEye();
		ok = !jumped && Distance2D( eye, focus ) < 320 && BulletTracePassed( eye, focus, false, undefined ) && lead_out_of_view( eye, focus );
		if ( self.mw2coop_awake && jumped )
		{
			self.mw2coop_blackout.alpha = 1;	// at once, before the jump shows
			self stunned_texts_fade( 1, 0 );
			self.mw2coop_awake = false;
		}
		if ( self.mw2coop_awake && ( !self.mw2coop_want_awake || !ok ) )
			self witness_black( true );
		if ( !self.mw2coop_awake && self.mw2coop_want_awake )
		{
			if ( !ok )
			{
				spot = watch_spot( focus );
				if ( !isdefined( spot ) )
					continue;
				cam.origin = spot - ( 0, 0, self.mw2coop_eye_dz );
			}
			cam.angles = VectorToAngles( focus - self GetEye() );
			self witness_black( false );
		}
		cam RotateTo( VectorToAngles( focus - self GetEye() ), 0.4, 0.15, 0.15 );
	}
}

witness_black( on )
{
	if ( on )
	{
		self.mw2coop_blackout FadeOverTime( 0.6 );
		self.mw2coop_blackout.alpha = 1;
		self stunned_texts_fade( 1, 0.6 );
		self.mw2coop_awake = false;
		wait 0.6;
	}
	else
	{
		self.mw2coop_blackout FadeOverTime( 1.2 );
		self.mw2coop_blackout.alpha = 0;
		self stunned_texts_fade( 0, 0.6 );
		self.mw2coop_awake = true;
	}
}

// walkoff(): the end; he stays out (his screen black) and the credits roll for both.
witness_gets_up()
{
	w = witness();
	if ( !isdefined( w ) )
		return;
	w.mw2coop_want_awake = false;
}

// --------------------------------------------------------------------------------------------
// Input and screen

// The fades: on both screens in co-op (the scene cuts in time for both players).
black_overlay()
{
	if ( coop() )
		return maps\_hud_util::create_client_overlay( "black", 0 );
	return maps\_hud_util::create_client_overlay( "black", 0, level.mw2coop_lead );
}

// The crawl to the revolver: the hints show +attack (right) and +speed_throw (left); in co-op
// the lead's usercmd (the original read this PC's mouse buttons). QA can hold buttons through
// level.mw2coop_lead.mw2coop_qa_hold.
crawl_pressed( side, key )
{
	lead = level.mw2coop_lead;
	if ( !coop() )
		return lead ButtonPressed( key );
	if ( isdefined( lead.mw2coop_qa_hold ) && isdefined( lead.mw2coop_qa_hold[ side ] ) && lead.mw2coop_qa_hold[ side ] )
		return true;
	if ( side == "right" )
		return lead AttackButtonPressed();
	return lead AdsButtonPressed();
}

use_pressed()
{
	lead = level.mw2coop_lead;
	if ( isdefined( lead.mw2coop_qa_hold ) && isdefined( lead.mw2coop_qa_hold[ "use" ] ) && lead.mw2coop_qa_hold[ "use" ] )
		return true;
	return lead UseButtonPressed();
}

attack_pressed()
{
	lead = level.mw2coop_lead;
	if ( isdefined( lead.mw2coop_qa_hold ) && isdefined( lead.mw2coop_qa_hold[ "attack" ] ) && lead.mw2coop_qa_hold[ "attack" ] )
		return true;
	return lead AttackButtonPressed();
}

// The text on the stunned player's black screen (owner, 2026-10-20: "You are stunned, wait for
// the other player"). A localized string answered by the mod's DLL (src/localize.c): the game
// draws Cyrillic only from localized strings. Precached in maps\_mw2coop::main().
stunned_texts_create()
{
	elem = maps\_hud_util::createClientFontString( "default", 1.6 );
	elem maps\_hud_util::setPoint( "CENTER", undefined, 0, 0 );
	elem.sort = 1001;
	elem.foreground = true;
	elem.hidewheninmenu = true;
	elem SetText( &"MW2COOP_STUNNED" );
	elem.alpha = 0;
	self.mw2coop_stunned_texts = [];
	self.mw2coop_stunned_texts[ 0 ] = elem;
}

stunned_texts_fade( alpha, time )
{
	foreach ( elem in self.mw2coop_stunned_texts )
	{
		if ( time > 0 )
			elem FadeOverTime( time );
		elem.alpha = alpha;
	}
}
