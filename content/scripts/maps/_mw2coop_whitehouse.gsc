// mw2coop: Whiskey Hotel (dc_whitehouse) for two players. Called from
// mw2coop/patches/maps/dc_whitehouse.gsc.patch (generated by tools/gen_whitehouse_patches.py);
// outside a co-op campaign session it does nothing.
//
// The roof: "Use your flares!" gives each player a flare of his own (COD-MOD gave player 2 one
// too; owner, 2026-10-22). Each pops his own; the weapon sync is set to "own" for the scene, or
// player 1's flare, taken from him once popped, would be taken from player 2 as well.
#include common_scripts\utility;
#include maps\_utility;

// self: nothing (level). flare: the level's whitehouse_player_flare, run on player 2.
partner_flare( flare )
{
	if ( !maps\_mw2coop::is_campaign_coop() || !isdefined( level.player2 ) )
		return;
	sync = level.mw2coop_weapon_sync;
	level.mw2coop_weapon_sync = "own";
	level.player2 thread [[ flare ]]();
	maps\_mw2coop::state( "whitehouse: player 2 gets a flare of his own" );
	flag_wait( "whitehouse_wrapup" );
	level.mw2coop_weapon_sync = sync;
}
