// mw2coop: the Gulag's evacuation for two players (gulag_ending.gsc gulag_evac). Called from
// mw2coop/patches/maps/gulag_ending.gsc.patch and gulag_ending_anim.gsc.patch (generated by
// tools/gen_gulag_end_patches.py); outside a co-op campaign session every entry point does what the
// original code did.
//
// The scene is player 1's alone: he lies buried (the level's "evac" animation on his rig), gets
// free, holds the use key to clip the carabiner of the Pavelow's rope to his harness, and is pulled up
// and away ("hookup", "idle", "fly_away"); Soap's notetrack "player" decides when it is too late
// (the cave-in then buries a player who did not clip on). Player 2 stood in the rubble the whole
// time and the level ended without him. Now each player has a rig, a carabiner and an extra rig of his
// own, plays the same animations at the same time, and clips on by his own use (the rope's trigger stays
// on until both have). Both rigs are in one place, so the players do not see each other's body.
#include common_scripts\utility;
#include maps\_utility;
#include maps\_anim;

coop()
{
	return maps\_mw2coop::is_campaign_coop() && isdefined( level.player2 );
}

// gulag_evac(), after the level's guys are listed: player 2's rig takes part in the "evac" scene,
// with the carabiner and the extra rig of his own.
add_rig( guys )
{
	if ( !coop() )
		return guys;
	level.mw2coop_evac = spawnstruct();
	level.mw2coop_evac.rig = spawn_anim_model( "player_rig" );
	level.mw2coop_evac.carabiner = spawn_anim_model( "player_carabiner" );
	level.mw2coop_evac.extra = spawn_anim_model( "player_rig" );
	level.mw2coop_evac.extra Hide();
	level.mw2coop_evac.t0 = GetTime();
	guys[ "player_rig_2" ] = level.mw2coop_evac.rig;
	return guys;
}

// gulag_evac(), where player 1 is linked to his rig for the "evac" scene.
partner_linked()
{
	if ( !coop() )
		return;
	p2 = level.player2;
	p2 TakeAllWeapons();
	p2 AllowCrouch( false );
	p2 AllowProne( false );
	p2 PlayerLinkToDelta( level.mw2coop_evac.rig, "tag_player", 1, 0, 0, 0, 0, true );
	maps\_mw2coop::state( "gulag evac: player 2 is buried with player 1" );
}

// gulag_evac(), where the extra rig of the pulled-away scene gets its first frame.
partner_extra( ent )
{
	if ( !coop() )
		return;
	ent anim_first_frame_solo( level.mw2coop_evac.extra, "fly_away" );
	ent delayThread( 20.16, ::anim_single_solo, level.mw2coop_evac.extra, "fly_away" );
}

// gulag_evac(), after player 1 is free: player 2 follows his own part of the scene.
partner_free( ent )
{
	if ( !coop() )
		return;
	level thread partner_scene( ent );
}

// The black screen of the scene's start and end, on player 2's screen like player 1's.
partner_black( on, fade_time )
{
	if ( !coop() )
		return;
	if ( on )
	{
		if ( isdefined( level.mw2coop_evac_black ) )
			return;
		level.mw2coop_evac_black = maps\_hud_util::create_client_overlay( "black", 0, level.player2 );
		level.mw2coop_evac_black.alpha = 1;
		return;
	}
	if ( !isdefined( level.mw2coop_evac_black ) )
		level.mw2coop_evac_black = maps\_hud_util::create_client_overlay( "black", 0, level.player2 );
	level.mw2coop_evac_black FadeOverTime( fade_time );
	level.mw2coop_evac_black.alpha = 0;
}

partner_black_out()
{
	if ( !coop() )
		return;
	if ( !isdefined( level.mw2coop_evac_black ) )
		level.mw2coop_evac_black = maps\_hud_util::create_client_overlay( "black", 0, level.player2 );
	level.mw2coop_evac_black.alpha = 1;
}

// gulag_evac(): the wait for the player who clips on. The level's flag "player_uses_rig" is set by
// whoever uses the rope's trigger; in co-op each player waits for his own use (or for Soap's
// "too late").
use_wait( trigger, who )
{
	if ( !coop() )
	{
		flag_wait( "player_uses_rig" );
		return;
	}
	for ( ;; )
	{
		if ( isdefined( who.mw2coop_clipped ) || isdefined( level.soap.got_player_notetrack ) )
			return;
		trigger waittill( "trigger", user );
		if ( user == who )
		{
			who.mw2coop_clipped = true;
			return;
		}
	}
}

// gulag_evac(), where it turned the trigger off after the use: the other player may still use it.
trigger_done( trigger )
{
	if ( !coop() )
	{
		trigger trigger_off();
		return;
	}
	if ( isdefined( level.player.mw2coop_clipped ) && isdefined( level.player2.mw2coop_clipped ) )
		trigger trigger_off();
}

// got_player_notetrack(): has everybody who has to clip on done so (flag "player_uses_rig" is set by
// the first). One who did not is buried by the cave-in.
all_hooked()
{
	if ( !coop() )
		return flag( "player_uses_rig" );
	return isdefined( level.player.mw2coop_clipped ) && isdefined( level.player2.mw2coop_clipped );
}

// player 1's flow in gulag_evac() for player 2: free, clip on, hooked, pulled away.
partner_scene( ent )
{
	level endon( "mw2coop_level_end" );
	p2 = level.player2;
	e = level.mw2coop_evac;
	rig = e.rig;
	extra = e.extra;
	rigs = [];
	rigs[ "carabiner" ] = e.carabiner;
	rigs[ "rig" ] = rig;
	p2 Unlink();
	p2 AllowCrouch( true );
	p2 AllowProne( true );
	ent anim_first_frame( rigs, "hookup" );
	rig Hide();
	e.carabiner Hide();
	tag = spawn_tag_origin();
	tag LinkTo( extra, "tag_player", ( 0, 0, 0 ), ( 0, 0, 0 ) );

	trigger = getEntWithFlag( "player_uses_rig" );
	use_wait( trigger, p2 );
	trigger_done( trigger );
	if ( isdefined( level.soap.got_player_notetrack ) && !isdefined( p2.mw2coop_clipped ) )
		return;
	p2 AllowCrouch( false );
	p2 AllowProne( false );

	linked = false;
	if ( ( GetTime() - e.t0 ) * 0.001 < 18 )
	{
		linked = true;
		p2 PlayerLinkToBlend( rig, "tag_player", 0.5, 0.2, 0.2 );
		thread partner_groundref_and_fov( tag, rig );
		thread partner_hooks_up( ent, rigs );
	}
	maps\_mw2coop::state( "gulag evac: player 2 clipped on" );

	flag_wait( "player_gets_pulled" );
	rig Hide();
	p2 notify( "stop_opening_fov" );
	if ( !linked )
	{
		p2 PlayerLinkToBlend( extra, "tag_player", 0.5, 0.2, 0.2 );
		p2 PlayerSetGroundReferenceEnt( tag );
	}
	else
		thread partner_view_to_zero( extra, 1.5 );
	ent thread anim_single_solo( rig, "fly_away" );
}

partner_groundref_and_fov( tag, rig )
{
	p2 = level.player2;
	p2 PlayerSetGroundReferenceEnt( tag );
	wait 1;
	p2 endon( "stop_opening_fov" );
	wait 0.5;
	p2 PlayerLinkToDelta( rig, "tag_player", 1, 45, 45, 90, 15, true );
}

partner_hooks_up( ent, rigs )
{
	if ( flag( "player_gets_pulled" ) )
		return;
	level endon( "player_gets_pulled" );
	wait 0.3;
	rigs[ "carabiner" ] Show();
	rigs[ "rig" ] Show();
	ent anim_single( rigs, "hookup" );
	ent anim_loop_solo( rigs[ "rig" ], "idle" );
}

partner_view_to_zero( extra, time )
{
	flag_wait( "player_evac" );
	p2 = level.player2;
	p2 PlayerLinkToBlend( extra, "tag_player", time, time * 0.4, time * 0.4 );
	wait time;
	p2 PlayerLinkToDelta( extra, "tag_player", 18, 18, 18, 18, true );
}
