// mw2coop: The Only Easy Day... (oilrig) opening for two players. Called from
// mw2coop/patches/maps/oilrig.gsc.patch (generated by tools/gen_oilrig_patches.py); outside a
// co-op campaign session every entry point does what the original code did.
//
// Underwater: player 1 rides SDV "A" as before; player 2 rides SDV "B" in the place of the
// SEAL sdv02_swimmer1 (left out in co-op), with the player's own ride-and-swim animation on
// that SDV. Surface: each player bobs and swims in the water by the grate himself.
// Stealth kill: the level has a first-person kill for one of the two guards (the other is the
// SEAL's), so the player who strikes first (looking at the guard, melee) does it; the other
// watches from the water. The two SEALs then pull the killer out of the water, and after him
// the other player, with the same help-out animation.
#include common_scripts\utility;
#include maps\_utility;
#include maps\_anim;

coop()
{
	return maps\_mw2coop::is_campaign_coop() && isdefined( level.player2 );
}

player_name( player )
{
	if ( player == level.player )
		return "player 1";
	return "player 2";
}

// underwater_friendly_setup(): player 2 takes sdv02_swimmer1's place on SDV B.
leave_out_swimmer()
{
	if ( !coop() )
		return;
	guy = level.sdvSquad02[ 2 ];
	level.sdvSquad02 = array_remove( level.sdvSquad02, guy );
	if ( isdefined( guy ) )
	{
		if ( isdefined( guy.magic_bullet_shield ) )
			guy stop_magic_bullet_shield();
		guy Delete();
	}
	maps\_mw2coop::state( "oilrig: sdv02_swimmer1 left out, player 2 rides SDV B" );
}

// underwater_sequence(): every player rides an SDV.
players_ride( sdv_a, sdv_b, node )
{
	level.player thread maps\oilrig::player_sdv_think( sdv_a, node );
	if ( coop() )
		level.player2 thread maps\oilrig::player_sdv_think( sdv_b, node );
}

// self: player. Only player 1's rig drives the level's swim flags (both rigs play the same
// animation, so they end together).
rig_flags( rig )
{
	if ( !coop() || self == level.player )
		rig thread maps\oilrig::underwater_player_flags();
}

// Every player shakes underwater, not only player 1.
slowview()
{
	foreach ( player in level.players )
		player ShellShock( "slowview", 0.1 );
}

// player_breaks_surface(): every player bobs in the water.
players_bob()
{
	if ( !coop() )
	{
		level.player thread maps\oilrig::water_bob();
		return;
	}
	foreach ( player in level.players )
		player thread maps\oilrig::water_bob();
}

// self: the bobbing model's player (water_movement). He swims until his own turn to be
// pulled out (player 1's flag outside co-op).
ready_to_be_helped()
{
	if ( !coop() )
		return flag( "player_ready_to_be_helped_from_water" );
	return isdefined( self.mw2coop_being_helped );
}

// Any player near the grate looking at the guard (the hint shows for both).
any_player_looking( org )
{
	trig = GetEnt( "trig_player_near_grate_guard", "script_noteworthy" );
	foreach ( player in level.players )
	{
		if ( !coop() && player != level.player )
			continue;
		if ( isdefined( trig ) && !( player IsTouching( trig ) ) && coop() )
			continue;
		if ( within_fov( player GetEye(), player GetPlayerAngles(), org.origin, level.cosine[ "25" ] ) )
			return true;
	}
	return false;
}

// self: player, in player_grate_sequence_think(). Returns false when this player is the one who
// does the stealth kill (the original code goes on), true when the other player did it and this
// one has been pulled out of the water afterwards.
stealth_kill_turn( rig, node, exit )
{
	if ( !coop() )
	{
		maps\oilrig::waittill_player_triggers_stealth_kill();
		return false;
	}
	trig = GetEnt( "trig_player_near_grate_guard", "script_noteworthy" );
	org = GetEnt( trig.target, "targetname" );
	while ( !isdefined( level.mw2coop_oilrig_killer ) )
	{
		wait 0.05;
		if ( isdefined( level.mw2coop_oilrig_killer ) )
			break;
		// QA (self.mw2coop_qa_melee) strikes from wherever the bot is
		qa = isdefined( self.mw2coop_qa_melee );
		if ( !qa && !( self IsTouching( trig ) ) )
			continue;
		if ( !qa && !within_fov( self GetEye(), self GetPlayerAngles(), org.origin, level.cosine[ "25" ] ) )
			continue;
		if ( qa || self MeleeButtonPressed() )
		{
			level.mw2coop_oilrig_killer = self;
			self.mw2coop_being_helped = true;
			maps\_mw2coop::state( "oilrig: " + player_name( self ) + " does the stealth kill" );
			return false;
		}
	}
	if ( level.mw2coop_oilrig_killer == self )
		return false;

	// the other player did it: wait in the water, then be pulled out the same way
	rig Delete();
	flag_wait( "player_done_being_helped_from_water" );
	wait 0.5;
	self helped_out( node, exit );
	return true;
}

// self: the player still in the water. The killer's rig animation from its "help" notetrack on,
// with the two SEALs' help-out animation again.
helped_out( node, exit )
{
	maps\_mw2coop::state( "oilrig: the SEALs pull " + player_name( self ) + " out of the water" );
	rig = spawn_anim_model( "player_rig" );
	rig Hide();
	node anim_first_frame_solo( rig, "player_stealth_kill" );
	animation = rig getanim( "player_stealth_kill" );
	// run the rig through the kill part unseen, up to where the SEALs take hold
	node thread anim_single_solo( rig, "player_stealth_kill" );
	wait 0.05;
	rig SetFlaggedAnim( "single anim", animation, 1, 0, 8 );
	rig waittillmatch( "single anim", "help" );
	rig SetFlaggedAnim( "single anim", animation, 1, 0, 1 );

	self.mw2coop_being_helped = true;	// ends his swimming (water_movement)
	wait 0.1;
	self PlayerLinkToBlend( rig, "tag_player", 1, 0, 0 );
	rig Show();
	helpers = [];
	helpers[ 0 ] = maps\oilrig::get_AI_with_script_noteworthy( "allies", "water_helper_01" );
	helpers[ 1 ] = maps\oilrig::get_AI_with_script_noteworthy( "allies", "water_helper_02" );
	helpers = array_removeUndefined( helpers );
	if ( helpers.size == 2 )
		node thread anim_single( helpers, "surface_helpout" );

	rig waittillmatch( "single anim", "end" );
	self Unlink();
	rig Delete();
	spot = exit_spot( exit );
	self thread lerp_player_view_to_position( spot, exit.angles, 0.25, 1 );
	wait 0.3;
	self AllowCrouch( true );
	self AllowProne( true );
	self AllowSprint( true );
	self AllowJump( true );
	self maps\oilrig::set_speed( level.playerCQBSpeed );
	self EnableWeapons();
	self.mw2coop_out_of_water = true;
	maps\_mw2coop::state( "oilrig: " + player_name( self ) + " out of the water" );
}

// Beside the killer's exit spot, on floor.
exit_spot( exit )
{
	forward = AnglesToForward( ( 0, exit.angles[ 1 ], 0 ) );
	right = AnglesToRight( ( 0, exit.angles[ 1 ], 0 ) );
	offsets = [];
	offsets[ 0 ] = right * 40;
	offsets[ 1 ] = right * -40;
	offsets[ 2 ] = forward * 40;
	foreach ( offset in offsets )
	{
		at = exit.origin + offset;
		floor = PlayerPhysicsTrace( at + ( 0, 0, 30 ), at - ( 0, 0, 60 ) );
		if ( abs( floor[ 2 ] - exit.origin[ 2 ] ) < 24 && BulletTracePassed( exit.origin + ( 0, 0, 30 ), at + ( 0, 0, 30 ), false, undefined ) )
			return floor;
	}
	return exit.origin;
}

// killtrigger_ocean_on(): the ocean kills a player who falls back into the water once he is out;
// in co-op not the player still waiting by the grate to be pulled out.
ocean_can_kill( player )
{
	if ( !coop() )
		return true;
	if ( isdefined( level.mw2coop_oilrig_killer ) && player == level.mw2coop_oilrig_killer )
		return true;
	return isdefined( player.mw2coop_out_of_water );
}

// start_surface() (a restart at the "surface" checkpoint): player 1 is put in the water by the
// grate; player 2 goes beside him, on a free side, unarmed as he is (QA tour 2026-10-22: he
// stayed at the map's player start, 15000 units away, and bobbed there).
partner_beside_at_surface( node )
{
	if ( !coop() )
		return;
	right = AnglesToRight( ( 0, node.angles[ 1 ], 0 ) );
	spot = level.player.origin + right * 56;
	foreach ( side in strtok( "56 -56 96 -96", " " ) )
	{
		try = level.player.origin + right * int( side );
		if ( Distance( PlayerPhysicsTrace( level.player.origin + ( 0, 0, 8 ), try + ( 0, 0, 8 ) ), try + ( 0, 0, 8 ) ) < 1 )
		{
			spot = try;
			break;
		}
	}
	level.player2 SetOrigin( spot );
	level.player2 SetPlayerAngles( node.angles );
	level.player2 DisableWeapons();
	maps\_mw2coop::state( "oilrig: player 2 surfaces beside player 1 (" + int( Distance( spot, level.player.origin ) ) + " units)" );
}

// self: player surfacing (water_bob). Player 2's swim ends higher than player 1's, over the
// walkway; he bobs at player 1's height, in the water.
bob_base()
{
	if ( !coop() || self == level.player )
		return self.origin;
	return ( self.origin[ 0 ], self.origin[ 1 ], level.player.origin[ 2 ] );
}

// --------------------------------------------------------------------------------------------
// The escape on the little bird (oilrig.gsc, the end of the mission). The level seated player 1
// alone, on the bench seat of the rider it hides (script_startingposition 2, tag_guy3), and the bird
// took off as soon as he sat; player 2 stayed on the roof. Now player 2 sits 53 units behind him on the
// same bench, in the place of the SEAL with script_startingposition 3 (hidden like the first one's;
// the seat between them stays Soap's). The bird takes off when both are on board, a minute after the first
// is for the other to come: a player who is slow is seated anyway.

// player_gets_on_littlebird(), after the rider of player 1's seat is hidden.
hide_partner_rider( riders )
{
	if ( !maps\_mw2coop::is_campaign_coop() || !isdefined( level.player2 ) )
		return;
	foreach ( guy in riders )
	{
		if ( guy.script_startingposition == 3 )
		{
			guy hide();
			guy setcontents( 0 );
			break;
		}
	}
}

// self: the bird. Player 2's seat: the bench seat 53 units behind player 1's, along the bird's own
// length, in the link's local coordinates of the same tag.
partner_seat( tag )
{
	tag_angles = self GetTagAngles( tag );
	delta = -53 * AnglesToForward( ( 0, self.angles[ 1 ], 0 ) );
	lx = VectorDot( delta, AnglesToForward( tag_angles ) );
	ly = 0 - VectorDot( delta, AnglesToRight( tag_angles ) );
	lz = VectorDot( delta, AnglesToUp( tag_angles ) );
	seat = spawn_tag_origin();
	seat.origin = self GetTagOrigin( tag ) + delta;
	seat.angles = tag_angles;
	seat linkto( self, tag, ( lx, ly, lz ), ( 0, -90, 0 ) );
	return seat;
}

// player_gets_on_littlebird(), from the wait for the trigger to the flag: the level's own steps for
// player 1 (seat1), and in co-op for player 2 (his own seat) when he gets to the trigger too.
board_all( bird, trigger, seat1, tag )
{
	if ( !maps\_mw2coop::is_campaign_coop() || !isdefined( level.player2 ) )
	{
		trigger waittill( "trigger" );
		seat_player( level.player, seat1 );
		flag_set( "player_on_board_littlebird" );
		return;
	}
	seat2 = bird partner_seat( tag );
	level thread board_when_near( level.player, level.player2, trigger, seat1 );
	level thread board_when_near( level.player2, level.player, trigger, seat2 );
	while ( !isdefined( level.player.mw2coop_seated ) || !isdefined( level.player2.mw2coop_seated ) )
		wait 0.1;
	maps\_mw2coop::state( "oilrig: both players are on the little bird" );
	flag_set( "player_on_board_littlebird" );
}

// A player boards when he reaches the trigger; a minute after the other one did, he is seated anyway.
board_when_near( player, other, trigger, seat )
{
	level endon( "mw2coop_level_end" );
	for ( ;; )
	{
		if ( player IsTouching( trigger ) )
			break;
		if ( isdefined( other.mw2coop_seated ) && GetTime() - other.mw2coop_seated > 60000 )
			break;
		wait 0.1;
	}
	seat_player( player, seat );
}

// player_gets_on_littlebird(), the steps for one player.
seat_player( player, seat )
{
	player freezeControls( true );
	setsaveddvar( "ui_hidemap", 1 );
	SetSavedDvar( "hud_showStance", "0" );
	SetSavedDvar( "compass", "0" );
	SetSavedDvar( "ammoCounterHide", "1" );
	player allowprone( false );
	player allowcrouch( false );
	player allowsprint( false );
	player allowjump( false );
	player disableWeapons();
	player PlayerLinkToBlend( seat, "tag_origin", 1, .2, .2 );
	wait 1;
	player PlayerLinkToDelta( seat, "tag_origin", 1.0, 40, 40, 10, 45 );
	player freezeControls( false );
	player takeallweapons();
	player GiveWeapon( "m14_scoped_arctic" );
	player SwitchToWeapon( "m14_scoped_arctic" );
	player enableWeapons();
	player.mw2coop_seated = GetTime();
}
