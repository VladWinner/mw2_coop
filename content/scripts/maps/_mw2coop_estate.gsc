// mw2coop: Loose Ends (estate) ending for two players. Called from
// mw2coop/patches/maps/estate.gsc.patch (generated by tools/gen_estate_patches.py); outside a
// co-op campaign session every entry point does nothing.
//
// The ending is a film through Roach's eyes: Ghost drags him to the LZ while he fights on his
// back, Shepherd shoots him and Ghost, Shepherd's men throw the bodies into a pit and burn them.
// In co-op both players go through it as Roach (owner, 2026-10-22: as in COD-MOD): every
// player is held on the same view (the level's code does to each player what it did to player
// 1), nobody has a body of his own, so the men throw the two bodies the level shows (Roach's
// and Ghost's) and both players go in the one throw. When Shepherd fires at Roach, player 2 is
// stunned: his screen goes black, no text, until the bodies are thrown.
#include common_scripts\utility;
#include maps\_utility;

coop()
{
	return maps\_mw2coop::is_campaign_coop() && isdefined( level.player2 );
}

// The ending starts (ending_moments(), flag play_ending_sequence): to the end of the mission
// neither player has a body or a name over his head. Both see from the same place, and a body
// drawn there would fill the other's view (Hide and hideOnClient do not hide a co-op player;
// the game's own way is a player without a model function, as in the Endgame boat).
players_into_ending()
{
	if ( !coop() || isdefined( level.mw2coop_estate_ending ) )
		return;
	level.mw2coop_estate_ending = true;
	if ( flag_exist( "coop_show_constant_icon" ) )
		flag_clear( "coop_show_constant_icon" );
	SetDvar( "mw2coop_hide_names", "1" );	// the DLL draws names at size 0 (src/control.c)
	foreach ( player in level.players )
	{
		if ( maps\_mw2coop::is_downed( player ) )
			maps\_mw2coop::state( "estate ending: " + player_name( player ) + " was down" );
		player maps\_utility::SetModelFunc( undefined );
	}
	maps\_mw2coop::state( "estate ending: both players in Roach's view, no bodies, no names" );
}

// Shepherd fires at Roach (notetrack shepherd_fire2; player 1 takes the hit as before). The
// other player sees from Roach's eyes, so the pistol points at him too: the same shot hits him
// as it hits Roach (the death shield of the ending keeps him alive), and he is stunned: his
// screen goes black (owner, 2026-10-22: shot by Shepherd, then a black screen, no text). Below
// the subtitles (sort -1, not foreground, as maps\_mw2coop_knife's blackout), so Ghost's "No!"
// and Shepherd still read.
partner_shot( gunpos )
{
	if ( !coop() )
		return;
	level.mw2coop_estate_black = [];
	foreach ( player in level.players )
	{
		if ( player == level.player )
			continue;
		player PlayRumbleOnEntity( "shepherd_pistol" );
		player SetNormalHealth( 1 );
		player DoDamage( 99 / player.damagemultiplier, gunpos );
		player delayThread( 0.3, ::full_health );
		black = NewClientHudElem( player );
		black.x = 0;
		black.y = 0;
		black SetShader( "black", 640, 480 );
		black.alignX = "left";
		black.alignY = "top";
		black.horzAlign = "fullscreen";
		black.vertAlign = "fullscreen";
		black.sort = -1;
		black.foreground = false;
		black.alpha = 0;
		black FadeOverTime( 0.3 );	// the hit shows first
		black.alpha = 1;
		level.mw2coop_estate_black[ level.mw2coop_estate_black.size ] = black;
		maps\_mw2coop::state( "estate ending: Shepherd shoots " + player_name( player ) + " too, he is stunned (black screen)" );
	}
}

// as estate.gsc ending_player_fullhealth()
full_health()
{
	self SetNormalHealth( 1 );
}

// The body toss (estate_ending_part2): his screen comes back with Roach's, over time seconds.
partner_wakes( time )
{
	if ( !isdefined( level.mw2coop_estate_black ) )
		return;
	foreach ( black in level.mw2coop_estate_black )
	{
		black FadeOverTime( time );
		black.alpha = 0;
	}
	maps\_mw2coop::state( "estate ending: the bodies are thrown, both see it" );
	wait time;
	foreach ( black in level.mw2coop_estate_black )
		black Destroy();
	level.mw2coop_estate_black = undefined;
}

// ending_blur_cycler(): the level's endingBlurView() on player 1 (blocking, it paces the cycle)
// and the same blur on everyone else beside it.
players_blur_view( blur, timer )
{
	foreach ( player in level.players )
		if ( player != level.player )
			player thread blur_view( blur, timer );
	level.player blur_view( blur, timer );
}

// as estate.gsc endingBlurView()
blur_view( blur, timer )
{
	level endon( "stop_blur_cycler" );
	self notify( "blurview_stop" );
	self endon( "blurview_stop" );
	self SetBlurForPlayer( blur, timer );
	wait 0.05;
	self SetBlurForPlayer( 0, timer );
}

player_name( player )
{
	if ( player == level.player )
		return "player 1";
	return "player 2";
}

// --------------------------------------------------------------------------------------------
// The bouncing-betty ambush on the way to the house (estate_code.gsc bouncing_betty_*; patched by tools/gen_estate_patches.py). In single player a
// mine pops up right in front of Roach ("his personal mine"): prone, it throws him away from it, he is shocked and can only lie for 5 s; standing,
// it kills him (the hint says to go prone). Player 2 had no mine: he walked through the ambush unthrown, unshocked, at full speed in the slow motion.
// Now each player has his own mine in front of him with the same rule; the scene's dialogue, the fake RPGs and its flags stay with player 1's mine.

// bouncing_betty_activate(), after player 1's mine: player 2's own mine, at his own ground spot in front of him (playerFovGroundSpot).
partner_mine()
{
	if ( !coop() || !IsAlive( level.player2 ) || maps\_mw2coop::is_downed( level.player2 ) )
		return;
	p2 = level.player2;
	mine_org = maps\estate_code::playerFovGroundSpot( "specialPlayerCase", p2 );
	skip_fx = undefined;
	if ( !isdefined( mine_org ) )
	{
		mine_org = p2.origin;
		skip_fx = 1;
	}
	thread maps\estate_code::bouncing_betty_throwplayer( mine_org, p2 );
	mine = Spawn( "script_origin", mine_org );
	mine thread maps\estate_code::bouncing_betty_fx( 1, undefined, skip_fx, p2 );
	maps\_mw2coop::state( "estate mines: player 2's own mine at " + mine_org + ", " + int( Distance( mine_org, p2.origin ) ) + " units from him" );
}

// player_can_see_origin() of maps\_utility for a given player (it asks player 1).
sees_origin( player, origin )
{
	if ( player == level.player )
		return player_can_see_origin( origin );
	if ( !player animscripts\battlechatter::pointInFov( origin ) )
		return false;
	return SightTracePassed( player GetEye(), origin, true, player );
}

// bouncing_betty_throwplayer(): the throw of a player waits for his own mine to find him prone (the level's flag "mine_throw_player" is set by the
// first); a player his mine killed is not thrown.
throw_wait( player )
{
	if ( !coop() )
	{
		flag_wait( "mine_throw_player" );
		return;
	}
	player endon( "death" );
	while ( !isdefined( player.mw2coop_mine_throw ) )
		wait 0.05;
	player.mw2coop_mine_throw = undefined;
	maps\_mw2coop::state( "estate mines: " + player_name( player ) + " is thrown by his mine" );
}

// bouncing_betty_shellshock() for player 2: the shock and, once the prone-only moment is over (player 1's stances), his stances and sprint back.
partner_mine_shock()
{
	self endon( "death" );
	self ShellShock( "estate_bouncingbetty", 10 );
	flag_wait( "ambushed_player_back_to_normal" );
	self AllowCrouch( true );
	self AllowStand( true );
	self AllowSprint( true );
}

// bouncing_betty_fx() of a mine in the woods (bouncing_betty_gameplay: it goes off when a player walks into it and looks at it): every player in its
// radius, not player 1 alone. Prone: the blast hurts the enemies only, he gets dirt on his screen and a short shock; standing: it kills him and the
// mission fails with the prone reminder, as it did for player 1. mine: the mine (its origin and radius).
gameplay_mine_blast( mine, explosion_org )
{
	prone = [];
	standing = [];
	foreach ( player in level.players )
	{
		if ( !IsAlive( player ) )
			continue;
		player PlayRumbleOnEntity( "artillery_rumble" );
		if ( Length( player.origin - mine.origin ) > mine.radius )
			continue;
		if ( player GetStance() == "prone" )
			prone[ prone.size ] = player;
		else
			standing[ standing.size ] = player;
	}
	if ( prone.size )
	{
		SetPlayerIgnoreRadiusDamage( true );
		mine thread maps\estate_code::bouncing_betty_gameplay_real_damage( explosion_org );
		foreach ( player in prone )
		{
			if ( within_fov( player.origin, player.angles + ( 0, -95, 0 ), mine.origin, Cos( 180 ) ) )
				player thread maps\_gameskill::grenade_dirt_on_screen( "right" );
			if ( within_fov( player.origin, player.angles + ( 0, 95, 0 ), mine.origin, Cos( 180 ) ) )
				player thread maps\_gameskill::grenade_dirt_on_screen( "left" );
			if ( within_fov( player.origin, player.angles, mine.origin, Cos( 10 ) ) )
				player thread maps\_gameskill::grenade_dirt_on_screen( "bottom_b" );
			player thread gameplay_mine_shock();
			maps\_mw2coop::state( "estate mines: a mine in the woods went off by " + player_name( player ) + ", prone: shocked" );
		}
	}
	if ( standing.size )
	{
		wait 0.2;
		damaged = false;
		foreach ( player in standing )
		{
			if ( !IsAlive( player ) )
				continue;
			if ( !damaged )
			{
				mine thread maps\estate_code::bouncing_betty_gameplay_real_damage( explosion_org );
				damaged = true;
			}
			level notify( "new_quote_string" );
			maps\_mw2coop::state( "estate mines: a mine in the woods killed " + player_name( player ) + " (not prone)" );
			player Kill();
			thread maps\estate_code::bouncing_betty_deathquote();
		}
	}
}

// bouncing_betty_gameplay_shock() for one player (it shocked player 1 and hid both from the enemies).
gameplay_mine_shock()
{
	self endon( "death" );
	self ShellShock( "estate_bouncingbetty", 3.5 );
	Earthquake( 1, 0.8, self.origin, 2000 );
	self.ignoreme = true;
	wait 3.5;
	self.ignoreme = false;
}
