// mw2coop: Loose Ends (estate) ending for two players. Called from
// mw2coop/patches/maps/estate.gsc.patch (generated by tools/gen_estate_patches.py); outside a
// co-op campaign session every entry point does nothing.
//
// The ending is a film through Roach's eyes: Ghost drags him to the LZ while he fights on his
// back, Shepherd shoots him and Ghost, Shepherd's men throw the bodies into a pit and burn them.
// In co-op both players go through it as Roach (owner, 2026-10-22: as in COD-MOD): every
// player is held on the same view (the level's code does to each player what it did to player
// 1), nobody has a body of his own, so the men throw the two bodies the level shows (Roach's
// and Ghost's) and both players go in the one throw. When Shepherd fires at Roach, player 2 is
// stunned: his screen goes black, no text, until the bodies are thrown.
#include common_scripts\utility;
#include maps\_utility;

coop()
{
	return maps\_mw2coop::is_campaign_coop() && isdefined( level.player2 );
}

// The ending starts (ending_moments(), flag play_ending_sequence): to the end of the mission
// neither player has a body or a name over his head. Both see from the same place, and a body
// drawn there would fill the other's view (Hide and hideOnClient do not hide a co-op player;
// the game's own way is a player without a model function, as in the Endgame boat).
players_into_ending()
{
	if ( !coop() || isdefined( level.mw2coop_estate_ending ) )
		return;
	level.mw2coop_estate_ending = true;
	if ( flag_exist( "coop_show_constant_icon" ) )
		flag_clear( "coop_show_constant_icon" );
	SetDvar( "mw2coop_hide_names", "1" );	// the DLL draws names at size 0 (src/control.c)
	foreach ( player in level.players )
	{
		if ( maps\_mw2coop::is_downed( player ) )
			maps\_mw2coop::state( "estate ending: " + player_name( player ) + " was down" );
		player maps\_utility::SetModelFunc( undefined );
	}
	maps\_mw2coop::state( "estate ending: both players in Roach's view, no bodies, no names" );
}

// Shepherd fires at Roach (notetrack shepherd_fire2; player 1 takes the hit as before). The
// other player sees from Roach's eyes, so the pistol points at him too: the same shot hits him
// as it hits Roach (the death shield of the ending keeps him alive), and he is stunned: his
// screen goes black (owner, 2026-10-22: shot by Shepherd, then a black screen, no text). Below
// the subtitles (sort -1, not foreground, as maps\_mw2coop_knife's blackout), so Ghost's "No!"
// and Shepherd still read.
partner_shot( gunpos )
{
	if ( !coop() )
		return;
	level.mw2coop_estate_black = [];
	foreach ( player in level.players )
	{
		if ( player == level.player )
			continue;
		player PlayRumbleOnEntity( "shepherd_pistol" );
		player SetNormalHealth( 1 );
		player DoDamage( 99 / player.damagemultiplier, gunpos );
		player delayThread( 0.3, ::full_health );
		black = NewClientHudElem( player );
		black.x = 0;
		black.y = 0;
		black SetShader( "black", 640, 480 );
		black.alignX = "left";
		black.alignY = "top";
		black.horzAlign = "fullscreen";
		black.vertAlign = "fullscreen";
		black.sort = -1;
		black.foreground = false;
		black.alpha = 0;
		black FadeOverTime( 0.3 );	// the hit shows first
		black.alpha = 1;
		level.mw2coop_estate_black[ level.mw2coop_estate_black.size ] = black;
		maps\_mw2coop::state( "estate ending: Shepherd shoots " + player_name( player ) + " too, he is stunned (black screen)" );
	}
}

// as estate.gsc ending_player_fullhealth()
full_health()
{
	self SetNormalHealth( 1 );
}

// The body toss (estate_ending_part2): his screen comes back with Roach's, over time seconds.
partner_wakes( time )
{
	if ( !isdefined( level.mw2coop_estate_black ) )
		return;
	foreach ( black in level.mw2coop_estate_black )
	{
		black FadeOverTime( time );
		black.alpha = 0;
	}
	maps\_mw2coop::state( "estate ending: the bodies are thrown, both see it" );
	wait time;
	foreach ( black in level.mw2coop_estate_black )
		black Destroy();
	level.mw2coop_estate_black = undefined;
}

// ending_blur_cycler(): the level's endingBlurView() on player 1 (blocking, it paces the cycle)
// and the same blur on everyone else beside it.
players_blur_view( blur, timer )
{
	foreach ( player in level.players )
		if ( player != level.player )
			player thread blur_view( blur, timer );
	level.player blur_view( blur, timer );
}

// as estate.gsc endingBlurView()
blur_view( blur, timer )
{
	level endon( "stop_blur_cycler" );
	self notify( "blurview_stop" );
	self endon( "blurview_stop" );
	self SetBlurForPlayer( blur, timer );
	wait 0.05;
	self SetBlurForPlayer( 0, timer );
}

player_name( player )
{
	if ( player == level.player )
		return "player 1";
	return "player 2";
}
