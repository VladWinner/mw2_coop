// mw2coop: "Second Sun" (dcemp) for two players after the crash site (maps\_mw2coop_crashsite):
// the ISS and coming back from the EMP white-out. Called from mw2coop/patches/maps/dcemp.gsc.patch
// and dcemp_code.gsc.patch (generated by tools/gen_dcemp_patches.py); outside a co-op campaign
// session every entry point does what the original code did.
//
// ISS: player 2 floats beside player 1 (a second camera following the first one). After the EMP
// flash each player is back in his own place in the wreck, and both are let out.
#include common_scripts\utility;
#include maps\_utility;
#include maps\_anim;

coop()
{
	return maps\_mw2coop::is_campaign_coop() && isdefined( level.player2 );
}

// iss_camera_setup(): player 2's camera floats beside player 1's and follows it.
partner_iss_camera( camera )
{
	if ( !coop() )
		return;
	p2 = level.player2;
	p2 AllowCrouch( false );
	p2 AllowProne( false );
	p2 FreezeControls( true );
	cam2 = Spawn( "script_model", camera.origin );
	cam2 SetModel( "tag_origin" );
	cam2.angles = camera.angles;
	cam2 LinkTo( camera, "tag_origin", ( 0, -64, 0 ), ( 0, 0, 0 ) );
	level.mw2coop_iss_camera = cam2;
	p2 PlayerLinkToDelta( cam2, "tag_origin", 1, 0, 0, 0, 0 );
	p2 PlayerSetGroundReferenceEnt( cam2 );
	maps\_mw2coop::state( "iss: player 2 floats beside player 1" );
}

// iss_main(): player 2's view and stance are kept for after the EMP, as player 1's are.
save_partner_view()
{
	if ( !coop() )
		return;
	p2 = level.player2;
	p2.mw2coop_emp_angles = p2 GetPlayerAngles();
	p2.mw2coop_emp_stance = p2 GetStance();
	p2 DisableWeapons();
	p2 FreezeControls( true );
	p2 AllowCrouch( false );
	p2 SetStance( "stand" );
}

// self: player, in emp_empaftermath().
emp_angles()
{
	if ( coop() && self != level.player && isdefined( self.mw2coop_emp_angles ) )
		return self.mw2coop_emp_angles;
	return level.emp_player_angles;
}

emp_stance()
{
	if ( coop() && self != level.player && isdefined( self.mw2coop_emp_stance ) )
		return self.mw2coop_emp_stance;
	return level.emp_player_stance;
}

// emp_main(): every player comes back from the white-out in his place in the wreck.
players_empaftermath()
{
	foreach ( player in maps\_mw2coop_crashsite::crash_players() )
		player thread maps\dcemp::emp_empaftermath();
	if ( coop() && isdefined( level.mw2coop_iss_camera ) )
		level.mw2coop_iss_camera Delete();
}

// Every player is let out of the wreck (player 2 a moment after player 1, beside him).
players_free()
{
	level.player thread maps\dcemp::emp_free_player();
	if ( coop() )
		level.player2 delayThread( 0.6, maps\dcemp::emp_free_player );
}

// self: player in emp_free_player(): where his move out of the wreck ends.
free_exit_origin( end )
{
	if ( !coop() || self == level.player )
		return end.origin;
	right = AnglesToRight( ( 0, end.angles[ 1 ], 0 ) );
	for ( side = 1; side >= -1; side -= 2 )
	{
		at = end.origin + right * ( 40 * side );
		floor = PlayerPhysicsTrace( at + ( 0, 0, 30 ), at - ( 0, 0, 60 ) );
		if ( abs( floor[ 2 ] - end.origin[ 2 ] ) < 20 && BulletTracePassed( end.origin + ( 0, 0, 30 ), at + ( 0, 0, 30 ), false, undefined ) )
			return floor;
	}
	return end.origin;
}
