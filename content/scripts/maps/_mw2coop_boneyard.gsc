// mw2coop: The Enemy of My Enemy (boneyard) for two players. Called from
// mw2coop/patches/maps/boneyard_code.gsc.patch (generated by tools/gen_boneyard_patches.py);
// outside a co-op campaign session every entry point does nothing.
//
// The UAZ ride to the C-130: player 1 jumps in as the passenger and later takes the wheel, as
// before; player 2 rides on the back seat with his own weapon all the way into the C-130 (owner,
// 2026-10-22: as COD-MOD did, with its seat 30 units back, 29 right and 30 up from the UAZ's
// origin; before, he stayed behind). Invulnerable while getting in, as player 1 is.
#include common_scripts\utility;
#include maps\_utility;

coop()
{
	return maps\_mw2coop::is_campaign_coop() && isdefined( level.player2 );
}

// self: the UAZ, player 1 getting in (uaz_control(), also from start point ride_end).
partner_boards()
{
	if ( !coop() || isdefined( level.mw2coop_uaz_seat ) )
		return;
	seat = spawn_tag_origin();
	seat.origin = self.origin;
	seat.angles = self.angles;
	seat LinkTo( self, "tag_origin", ( -30, -29, 30 ), ( 0, 0, 0 ) );
	level.mw2coop_uaz_seat = seat;
	p2 = level.player2;
	p2 EnableInvulnerability();
	p2 SetStance( "stand" );
	p2 AllowProne( false );
	p2 AllowCrouch( false );
	p2 AllowSprint( false );
	p2 AllowJump( false );
	// PlayerLinkTo as COD-MOD, his view following the UAZ by 0.75 as player 1's does (fully, it
	// rolled with every tilt of the UAZ, QA 2026-10-22)
	p2 PlayerLinkTo( seat, "tag_origin", 0.75, 180, 180, 75, 35 );
	p2 EnableWeapons();
	maps\_mw2coop::state( "boneyard: player 2 rides on the UAZ's back seat" );
}

// Player 1 has got in (vulnerable again): player 2 too.
partner_mounted()
{
	if ( coop() && isdefined( level.mw2coop_uaz_seat ) )
		level.player2 DisableInvulnerability();
}

// park_uaz(): the UAZ becomes an animated model that drives into the C-130; the seat goes with it.
partner_seat_to( dummy )
{
	if ( !isdefined( level.mw2coop_uaz_seat ) )
		return;
	level.mw2coop_uaz_seat Unlink();
	level.mw2coop_uaz_seat LinkTo( dummy );
}
