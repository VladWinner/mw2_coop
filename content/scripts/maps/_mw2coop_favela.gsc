// mw2coop: Takedown (favela) for two players. Called from mw2coop/patches/maps/favela.gsc.patch
// (generated by tools/gen_favela_patches.py); outside a co-op campaign session every entry point
// does what the original code did.
//
// Opening car ride: the level rides level.player on the front passenger seat of a sedan whose
// back seat is empty (Soap is spawned outside when he runs off). In co-op each player rides
// with his own rig: player 1 in front, player 2 behind him. Each ducks on his own crouch key
// (NotifyOnPlayerCommand), Makarov's deadly shots through the windshield kill whoever is not
// ducking, and at the end player 2 follows player 1 out through the open front door.
#include common_scripts\utility;
#include maps\_utility;

coop()
{
	return maps\_mw2coop::is_campaign_coop() && isdefined( level.player2 );
}

// opening_scene(): every player rides.
players_ride( vehicle )
{
	if ( !coop() )
	{
		level.player thread maps\favela::player_rides_vehicle( vehicle );
		return;
	}
	foreach ( player in level.players )
		player thread maps\favela::player_rides_vehicle( vehicle );
	maps\_mw2coop::state( "favela: both players ride the car, player 2 on the back seat" );
}

// Back seat, behind the front passenger seat (car's local x is forward).
back_seat_offset()
{
	return ( -40, 0, 0 );
}

// self: the player's rig. As the level placed player 1's rig, on tag_passenger; player 2's
// behind it.
place_rig( vehicle, player )
{
	self.mw2coop_player = player;
	offset = ( 0, 0, 0 );
	if ( coop() && player != level.player )
		offset = back_seat_offset();
	angles = vehicle GetTagAngles( "tag_passenger" );
	self.origin = vehicle GetTagOrigin( "tag_passenger" ) + AnglesToForward( angles ) * offset[ 0 ];
	self.angles = angles;
	self LinkTo( vehicle, "tag_passenger", offset, ( 0, 0, 0 ) );
}

// self: player. notifyOnCommand() notifies player 1 only; in co-op each player's own commands.
notify_on_command( msg, command )
{
	if ( !coop() )
	{
		notifyOnCommand( msg, command );
		return;
	}
	self NotifyOnPlayerCommand( msg, command );
}

// self: player. "player_is_ducking" stays the level's "a player ducks" (the hotel doors close);
// each player's own state decides the deadly shots.
set_ducking( on )
{
	if ( !coop() )
	{
		if ( on )
			flag_set( "player_is_ducking" );
		else
			flag_clear( "player_is_ducking" );
		return;
	}
	self.mw2coop_ducking = on;
	any = false;
	foreach ( player in level.players )
		if ( isdefined( player.mw2coop_ducking ) && player.mw2coop_ducking )
			any = true;
	if ( any )
		flag_set( "player_is_ducking" );
	else
		flag_clear( "player_is_ducking" );
}

// self: Makarov, on one of his deadly shots.
deadly_shot()
{
	if ( !coop() )
	{
		if ( !flag( "player_is_ducking" ) )
			self thread maps\favela::kill_player();
		return;
	}
	foreach ( player in level.players )
	{
		if ( isdefined( player.mw2coop_ducking ) && player.mw2coop_ducking )
			continue;
		if ( isdefined( player.mw2coop_shot ) )
			continue;
		player.mw2coop_shot = true;
		maps\_mw2coop::state( "favela: Makarov hits " + player_name( player ) + " (not ducking)" );
		self thread maps\favela::kill_player( player );
		level thread shot_player_fails_mission();
	}
}

// In the car there is no being downed and revived: a player Makarov hits is dead, and the
// mission fails as it does for one player (after his death animation in the seat).
shot_player_fails_mission()
{
	if ( isdefined( level.mw2coop_favela_failing ) )
		return;
	level.mw2coop_favela_failing = true;
	wait 1.5;
	maps\_utility::missionFailedWrapper();
}

player_name( player )
{
	if ( player == level.player )
		return "player 1";
	return "player 2";
}

// opening_scene(): every player gets out.
players_exit( vehicle )
{
	if ( !coop() )
	{
		level.player thread maps\favela::player_exits_vehicle( vehicle );
		return;
	}
	foreach ( player in level.players )
		player thread maps\favela::player_exits_vehicle( vehicle );
}

// self: player. Where he ends up outside the car: player 1 at the level's exit point, player 2
// beside it, on floor.
exit_point()
{
	exit = GetEnt( "player_vehicle_exit_point", "targetname" );
	if ( !coop() || self == level.player )
		return exit;
	spot = SpawnStruct();
	spot.angles = exit.angles;
	spot.origin = exit.origin;
	forward = AnglesToForward( ( 0, exit.angles[ 1 ], 0 ) );
	right = AnglesToRight( ( 0, exit.angles[ 1 ], 0 ) );
	candidates = [];
	candidates[ 0 ] = forward * -48;
	candidates[ 1 ] = right * 48;
	candidates[ 2 ] = right * -48;
	candidates[ 3 ] = forward * -48 + right * 40;
	foreach ( offset in candidates )
	{
		at = exit.origin + offset;
		if ( !BulletTracePassed( exit.origin + ( 0, 0, 40 ), at + ( 0, 0, 40 ), false, undefined ) )
			continue;
		floor = PlayerPhysicsTrace( at + ( 0, 0, 40 ), at - ( 0, 0, 60 ) );
		if ( abs( floor[ 2 ] - exit.origin[ 2 ] ) > 24 )
			continue;
		spot.origin = floor;
		break;
	}
	return spot;
}

// self: player getting out; dummy: what he is linked to. Player 2 waits until player 1 is out,
// then slides over to the front seat to get out through the open door.
via_front_seat( dummy, vehicle )
{
	if ( !coop() || self == level.player )
		return;
	if ( isdefined( self.mw2coop_shot ) )
		level waittill( "forever" );	// shot in his seat: the mission is failing
	wait 1.6;	// player 1 is moved out over 1.5 s
	seat = vehicle GetTagOrigin( "tag_passenger" );
	dummy MoveTo( seat + ( 0, 0, 10 ), 0.7, 0.2, 0.2 );
	wait 0.7;
	maps\_mw2coop::state( "favela: player 2 gets out" );
}
