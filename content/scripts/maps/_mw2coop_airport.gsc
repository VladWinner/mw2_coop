// mw2coop: No Russian (airport) for two players. Called from mw2coop/patches/maps/airport.gsc.patch
// and airport_code.gsc.patch (generated by tools/gen_airport_patches.py); outside a co-op
// campaign session every entry point does what the original code did.
//
// Elevator: the level holds player 1's view on a node at the back of the elevator (zoomed, gas
// mask overlay) for the ride; player 2 stood on the same spot. He gets his own place at the back
// wall beside player 1, held the same way, and is let go with him.
//
// Ending (owner's decision: Makarov kills both): Makarov shoots first the player who came up to
// the van (the close ending: "no message") or else the nearer one, then turns and shoots the
// other. Each player's white flash is his own; the death vision comes with the second shot.
#include common_scripts\utility;
#include maps\_utility;
#include maps\_anim;

coop()
{
	return maps\_mw2coop::is_campaign_coop() && isdefined( level.player2 );
}

// node: player 1's view node (his origin and angles).
partner_in_elevator( node )
{
	if ( !coop() )
		return;
	p2 = level.player2;
	spot = elevator_spot( node );
	p2 SetOrigin( spot );
	p2 SetPlayerAngles( node.angles );
	level.mw2coop_elevator_node = Spawn( "script_origin", spot );
	level.mw2coop_elevator_node.angles = node.angles;
	p2 PlayerLinkTo( level.mw2coop_elevator_node, undefined, 1, 0, 0, 0, 0, 0 );
	maps\_mw2coop::state( "airport: player 2 in the elevator " + int( Distance( spot, node.origin ) ) + " units beside player 1" );
}

partner_out_of_elevator( angles )
{
	if ( !coop() || !isdefined( level.mw2coop_elevator_node ) )
		return;
	level.player2 Unlink();
	level.player2 SetPlayerAngles( angles );
	level.mw2coop_elevator_node Delete();
}

// A free spot at the back of the elevator beside player 1: floor at his height, a clear line from
// him, and nobody of the team standing there.
elevator_spot( node )
{
	yaw = ( 0, node.angles[ 1 ], 0 );
	right = AnglesToRight( yaw );
	forward = AnglesToForward( yaw );
	offsets = [];
	offsets[ offsets.size ] = right * 36;
	offsets[ offsets.size ] = right * -36;
	offsets[ offsets.size ] = right * 32 + forward * 12;
	offsets[ offsets.size ] = right * -32 + forward * 12;
	offsets[ offsets.size ] = right * 44;
	offsets[ offsets.size ] = right * -44;
	chest = node.origin + ( 0, 0, 40 );
	ai = GetAIArray( "allies" );
	foreach ( offset in offsets )
	{
		at = node.origin + offset;
		if ( !BulletTracePassed( chest, at + ( 0, 0, 40 ), false, level.player ) )
			continue;
		floor = PlayerPhysicsTrace( at + ( 0, 0, 30 ), at - ( 0, 0, 40 ) );
		if ( abs( floor[ 2 ] - node.origin[ 2 ] ) > 12 )
			continue;
		taken = false;
		foreach ( guy in ai )
			if ( Distance2D( guy.origin, floor ) < 30 )
				taken = true;
		if ( taken )
			continue;
		return floor;
	}
	return node.origin + right * 36;
}

// --------------------------------------------------------------------------------------------
// Ending

// grab_player_if_he_gets_close(): a player in place for the close ending (player 1 outside
// co-op). The first one becomes Makarov's first victim.
someone_ready_for_ending( origin )
{
	if ( !coop() )
		return level.player maps\airport_code::player_ready_for_ending( origin );
	foreach ( player in level.players )
	{
		if ( IsAlive( player ) && player maps\airport_code::player_ready_for_ending( origin ) )
		{
			level.mw2coop_ending_first = player;
			maps\_mw2coop::state( "airport: " + player_name( player ) + " is at the van" );
			return true;
		}
	}
	return false;
}

player_name( player )
{
	if ( player == level.player )
		return "player 1";
	return "player 2";
}

// player_loses_speed(): the player at the van slows down.
slowed_players()
{
	a = [];
	if ( coop() && isdefined( level.mw2coop_ending_first ) )
		a[ 0 ] = level.mw2coop_ending_first;
	else
		a[ 0 ] = level.player;
	return a;
}

// escape_end_sequence(): Makarov shoots the players.
ending_deaths()
{
	if ( !coop() )
	{
		level.mw2coop_ending_victim = level.player;
		if ( flag( "player_ready_for_proper_ending" ) )
			level.player maps\airport_code::escape_animate_player_death();
		else
			level.player maps\airport_code::escape_animate_player_death2();
		return;
	}
	first = victim();
	second = maps\_mw2coop::other_player( first );
	level.mw2coop_ending_victim = first;
	level.mw2coop_ending_left = 2;
	maps\_mw2coop::state( "airport: Makarov shoots " + player_name( first ) + " first" );
	if ( flag( "player_ready_for_proper_ending" ) )
		first maps\airport_code::escape_animate_player_death();
	else
		first maps\airport_code::escape_animate_player_death2();
	if ( isdefined( second ) && IsAlive( second ) )
		second_shot( second );
}

// Makarov turns to the other player and shoots him (his shooting animation of the far ending);
// the player goes down where he stands.
second_shot( victim )
{
	maps\_mw2coop::state( "airport: Makarov turns to " + player_name( victim ) );
	mak = level.makarov;
	van = level.escape_van_dummy;
	victim TakeAllWeapons();
	victim FreezeControls( true );
	level.mw2coop_ending_victim = victim;
	flag_clear( "escape_player_shot" );

	mak SetLookAtEntity( victim );
	mak StopAnimScripted();
	mak Unlink();
	to = VectorToAngles( victim.origin - mak.origin );
	mak ForceTeleport( mak.origin, ( 0, to[ 1 ], 0 ) );
	mak AnimCustom( maps\airport_code::makarov_shoot_player );
	flag_wait( "escape_player_shot" );

	ent = getstruct( "escape_ending_node", "targetname" );
	node = Spawn( "script_origin", ( victim.origin[ 0 ], victim.origin[ 1 ], ent.origin[ 2 ] ) + ( 0, 0, 4.5 ) );
	node.angles = victim.angles;
	model = spawn_anim_model( "player_ending" );
	model.mw2coop_victim = victim;
	model LinkTo( node );
	model NotSolid();
	angles = VectorToAngles( mak.origin - victim.origin );
	node RotateTo( ( 0, angles[ 1 ], 0 ), 1.5 );
	time = 0.1;
	victim PlayerLinkToBlend( model, "tag_player", time, time * 0.5, time * 0.5 );
	node thread anim_single_solo( model, "end_player_shot_alt" );
	model thread maps\airport_code::escape_draw_blood();
	PhysicsExplosionCylinder( node.origin, 96, 2, 3 );

	mak waittill( "done_shoot_player" );
	mak LinkTo( van, "tag_body" );
	mak SetLookAtEntity();
}

// escape_kill_player() (Makarov's "fire" notetrack): who is shot. The player at the van, else the
// one nearer to Makarov; kept for the rest of the first shot.
victim()
{
	if ( isdefined( level.mw2coop_ending_victim ) )
		return level.mw2coop_ending_victim;
	if ( !coop() )
		return level.player;
	first = level.mw2coop_ending_first;
	if ( !isdefined( first ) )
	{
		first = level.player;
		if ( Distance( level.player2.origin, level.makarov.origin ) < Distance( level.player.origin, level.makarov.origin ) )
			first = level.player2;
	}
	level.mw2coop_ending_victim = first;
	return first;
}

// escape_kill_player(): the death vision once the last player is shot.
death_vision()
{
	if ( coop() && isdefined( level.mw2coop_ending_left ) )
	{
		level.mw2coop_ending_left--;
		if ( level.mw2coop_ending_left > 0 )
			return;
	}
	set_vision_set( "airport_death", 10 );
}
