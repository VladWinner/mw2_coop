// mw2coop: Exodus (arcadia) for two players. Called from mw2coop/patches/maps/arcadia.gsc.patch and
// arcadia_code.gsc.patch (generated by tools/gen_arcadia_patches.py); outside a co-op campaign
// session every entry point gives what the original code used (player 1).
//
// The laser designator that calls the Stryker's fire (and the golf course artillery) goes to one
// player, either of the two at random (owner, 2026-10-22): with one each the Stryker would get
// targets from both sides at once and turn between them or fire late. Its hints show to him.
#include common_scripts\utility;
#include maps\_utility;

// The player holding the laser designator, chosen once per level start. RandomInt gives the same
// number on both lockstep machines.
laser_player()
{
	if ( isdefined( level.mw2coop_laser_player ) )
		return level.mw2coop_laser_player;
	level.mw2coop_laser_player = level.player;
	if ( maps\_mw2coop::is_campaign_coop() && isdefined( level.player2 ) && RandomInt( 2 ) == 1 )
		level.mw2coop_laser_player = level.player2;
	if ( level.mw2coop_laser_player == level.player2 )
		maps\_mw2coop::state( "exodus: player 2 has the laser designator" );
	else
		maps\_mw2coop::state( "exodus: player 1 has the laser designator" );
	return level.mw2coop_laser_player;
}
