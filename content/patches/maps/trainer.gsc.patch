mw2coop patch for maps/trainer.gsc (S.S.D.D., Modern Warfare 2, 64-bit Steam build)

1. Co-op settings: each player takes his own weapons (section 4); checkpoints = start points.
@@@ replace
	level.color[ "blue" ] = ( .1, .3, 1 );
@@@ with
	level.color[ "blue" ] = ( .1, .3, 1 );

	level.mw2coop_weapon_sync = "own";
	maps\_mw2coop::add_checkpoint( "firing_range_hip_and_ads_done", "timed_ads" );
	maps\_mw2coop::add_checkpoint( "firing_range_timed_ads_done", "bullet_penetration" );
	maps\_mw2coop::add_checkpoint( "firing_range_penetration_done", "frag" );
	maps\_mw2coop::add_checkpoint( "firing_range_frags_done", "pit" );
	maps\_mw2coop::add_checkpoint( "sidearm_complete", "course" );
	maps\_mw2coop::add_checkpoint( "player_done_with_course", "end" );
@@@ end

2. Endless ammo on the range for every player, not just player 1.
@@@ replace
	level.player thread never_run_out_of_ammo();
}
@@@ with
	foreach ( player in level.players )
		player thread never_run_out_of_ammo();
}
@@@ end

@@@ replace
		level.player waittill( "reload_start" );
		if ( flag( "player_inside_course" ) )
			break;
		weaponName = self GetCurrentWeapon();
		if ( level.player GetWeaponAmmoStock( weaponName ) < 100 )
		{
			level.player SetWeaponAmmoStock( weaponName, 9999 );
@@@ with
		self waittill( "reload_start" );
		if ( flag( "player_inside_course" ) )
			break;
		weaponName = self GetCurrentWeapon();
		if ( self GetWeaponAmmoStock( weaponName ) < 100 )
		{
			self SetWeaponAmmoStock( weaponName, 9999 );
@@@ end

3. Ending: both players are safe, slowed, cannot sprint and fade out together.
@@@ replace
	level.player enableinvulnerability( true );
@@@ with
	foreach ( player in level.players )
		player enableinvulnerability( true );
@@@ end

@@@ replace
	level.player allowsprint( false );
@@@ with
	foreach ( player in level.players )
		player allowsprint( false );
@@@ end

@@@ replace
		level.player SetMoveSpeedScale( currentMoveRate );
@@@ with
		foreach ( player in level.players )
			player SetMoveSpeedScale( currentMoveRate );
@@@ end

@@@ replace
	black_overlay = create_client_overlay( "black", 0, level.player );
@@@ with
	black_overlay = create_client_overlay( "black", 0, level.player );
	if ( isdefined( level.player2 ) )
	{
		black_overlay2 = create_client_overlay( "black", 0, level.player2 );
		black_overlay2 fadeOverTime( 1 );
		black_overlay2.alpha = 1;
	}
@@@ end

4. Weapons on the range: each player takes his own (maps\_mw2coop_trainer). The rifle and the
   pistol on the tables lie there again until both have one, the frag box serves whoever uses
   it, and the level goes on once both players have them.
@@@ replace
	level.gunSidearm = "deserteagle";
@@@ with
	level.gunSidearm = "deserteagle";
	level thread maps\_mw2coop_trainer::own_pickup( "pickup_rifle", level.gunPrimary, maps\_mw2coop_trainer::rifle_hidden_parts() );
	level thread maps\_mw2coop_trainer::own_pickup( "pickup_sidearm", level.gunSidearm );
@@@ end

@@@ replace
	level.player takeallweapons();
@@@ with
	foreach ( player in level.players )
		player takeallweapons();
@@@ end

@@@ replace
	if ( level.player HasWeapon( level.gunPrimary ) )
@@@ with
	if ( maps\_mw2coop_trainer::everyone_has( level.gunPrimary ) )
@@@ end

@@@ replace
	if ( !level.player HasWeapon( level.gunSidearm ) )
@@@ with
	if ( !maps\_mw2coop_trainer::everyone_has( level.gunSidearm ) )
@@@ end

@@@ replace
	while ( ! level.player HasWeapon( level.gunSidearm ) )
@@@ with
	while ( !maps\_mw2coop_trainer::everyone_has( level.gunSidearm ) )
@@@ end

@@@ subst firing_range_frags
level.player GetWeaponAmmoStock( "fraggrenade" ) < 3
@@@ to
!maps\_mw2coop_trainer::everyone_has_frags( 3 )
@@@ end

@@@ replace
		frag_trigger waittill( "trigger" );
@@@ with
		frag_trigger waittill( "trigger", who );
		if ( !isdefined( who ) || !IsPlayer( who ) )
			continue;
@@@ end

@@@ subst spawn_frags
level.player
@@@ to
who
@@@ end

@@@ replace
		if ( !flag( "player_picked_up_frags" ) )
		{
			flag_set( "player_picked_up_frags" );
			who giveWeapon( "fraggrenade" );
@@@ with
		if ( !who HasWeapon( "fraggrenade" ) )
		{
			flag_set( "player_picked_up_frags" );
			who giveWeapon( "fraggrenade" );
@@@ end

@@@ replace
			hide_frags_till_player_not_looking( fragsToHide );
@@@ with
			hide_frags_till_player_not_looking( fragsToHide, who );
@@@ end

@@@ replace
hide_frags_till_player_not_looking( fragsToHide )
{
@@@ with
hide_frags_till_player_not_looking( fragsToHide, who )
{
@@@ end

@@@ subst hide_frags_till_player_not_looking
level.player
@@@ to
who
@@@ end

@@@ replace
	thread show_me_when_player_not_looking_or_timeout( hiddenFrags, 3 );
@@@ with
	thread show_me_when_player_not_looking_or_timeout( hiddenFrags, 3, who );
@@@ end

@@@ replace
show_me_when_player_not_looking_or_timeout( hiddenFrags, timeout )
{
@@@ with
show_me_when_player_not_looking_or_timeout( hiddenFrags, timeout, who )
{
@@@ end

@@@ subst show_me_when_player_not_looking_or_timeout
level.player
@@@ to
who
@@@ end

5. The firing range: both players inside the sandbag bay, player 1 on the left.
@@@ replace
	level.player SetPlayerAngles( player_start_range.angles );
@@@ with
	level.player SetPlayerAngles( player_start_range.angles );
	level thread maps\_mw2coop_trainer::range_places( player_start_range );
@@@ end

6. The obstacle course: its gates and the blocker at the end close once BOTH players are through
   (the entrance gate after both went upstairs, the exit gate and the blocker after both reached
   the end); either player set the trigger flags, and the first one locked the other in. A sprint
   to the exit counts for whichever player runs it.
@@@ subst course_loop_think
flag_wait( "player_course_upstairs" );
@@@ to
flag_wait( "player_course_upstairs" );
		maps\_mw2coop_trainer::both_past( "player_course_upstairs" );
@@@ end
@@@ subst course_loop_think
flag_wait( "player_course_end" );
@@@ to
flag_wait( "player_course_end" );
		maps\_mw2coop_trainer::both_past( "player_course_end" );
@@@ end
@@@ subst player_sprint_monitor
( isdefined( velocity ) ) && ( velocity > 250 ) && ( level.player istouching( sprint_volume ) )
@@@ to
maps\_mw2coop_trainer::someone_sprinting( sprint_volume )
@@@ end
