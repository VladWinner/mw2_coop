14. The flash-bang and grenade-launcher lessons (shown to both players) go away by the throw or the weapon of the player who
   sees them: their break tests read player 1's (night audit 2026-11-17). The level also calls player_learned_m203() on itself
   (riverbank_player_learns_m203): that call stays player 1's (get_player_from_self).
@@@ replace
	level.player.flash_ammo = level.player GetWeaponAmmoStock( "flash_grenade" );
@@@ with
	foreach ( mw2coop_player in level.players )
		mw2coop_player.flash_ammo = mw2coop_player GetWeaponAmmoStock( "flash_grenade" );
@@@ end

   (same)
@@@ replace
player_learned_flash()
{
	flash_ammo = level.player GetWeaponAmmoStock( "flash_grenade" );
	if ( flash_ammo <= 0 )
		return true;

	return level.player.flash_ammo > flash_ammo;
}
@@@ with
player_learned_flash()
{
	mw2coop_player = get_player_from_self();
	flash_ammo = mw2coop_player GetWeaponAmmoStock( "flash_grenade" );
	if ( flash_ammo <= 0 )
		return true;

	return mw2coop_player.flash_ammo > flash_ammo;
}
@@@ end

   (same)
@@@ replace
player_learned_m203()
{
	if ( flag( "leaving_riverbank" ) )
		return true;
		
	return level.player getcurrentweapon() == "m203_m4_eotech";
}
@@@ with
player_learned_m203()
{
	mw2coop_player = get_player_from_self();
	if ( flag( "leaving_riverbank" ) )
		return true;
		
	return mw2coop_player getcurrentweapon() == "m203_m4_eotech";
}
@@@ end
